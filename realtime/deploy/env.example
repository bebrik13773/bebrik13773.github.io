# Скопируй в realtime/.env на сервере и поправь
WF_DOMAIN=bober-forest.duckdns.org
WF_ORIGINS=https://bober-api.gt.tc
WF_MAX_CONN=150

# Подписи токенов (РТ-02). Значения печатает: node tools/gen-keys.mjs (секреты PHP идут в GitHub Secrets, эти четыре сюда)
WF_RT_ALG=ed25519
WF_RT_SIGN_KID=r1
WF_RT_SIGN_KEY=
WF_RT_VERIFY_KEYS=p1:
